# HuggingFace API Token
# Erhalte deinen Token unter: https://huggingface.co/settings/tokens
# Umbenennen zu '.env' und Token eintragen:
HF_TOKEN=<your-token>

# Name der HuggingFace-Collection, die synchronisiert werden soll
HF_COLLECTION=LocalCache

# Was mit Dateien geschieht, die es stromaufwärts nicht mehr gibt:
#   move   – nach ~/southbyte/_retired/hf_models-prune/<Datum>/ verschieben (Vorgabe)
#   delete – lokal entfernen
#   report – nur melden, nichts anfassen
HF_PRUNE_MODE=move
